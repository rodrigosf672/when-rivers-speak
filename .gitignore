# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env

# Caches
.cache/
.river_cache/
.ruff_cache/
.pytest_cache/
.ipynb_checkpoints/

# Data: ship only the small bundled sample; never commit large / full datasets.
data/full/
*.duckdb
*.duckdb.wal
# Keep the sample Parquet + manifest that back demo mode.
!data/sample/
!data/sample/**

# OS / editor
.DS_Store
.idea/
.vscode/

# The DuckDB file is built from the sample Parquet (scripts/build_database.py);
# the negation above would otherwise re-include it.
data/sample/*.duckdb
data/sample/*.duckdb.wal

# River Pulse map layers, derived on first run (raw downloads live in .cache/),
# plus the build's lock file and staging directory.
data/sample/pulse/
data/sample/.pulse*

# marimo session snapshots.
__marimo__/
